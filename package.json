{
  "name": "vue-composable-toolkit",
  "version": "1.1.0",
  "description": "Vue 3 composables written in strict TypeScript: virtual list, form validation, storage sync, async queue, event bus, permissions and more",
  "keywords": [
    "vue",
    "vue3",
    "composables",
    "composition-api",
    "typescript",
    "hooks",
    "virtual-list",
    "form-validation",
    "event-bus"
  ],
  "license": "MIT",
  "author": "Mohammed Aqib (https://github.com/imaqib101)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imaqib101/vue-composable-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/imaqib101/vue-composable-toolkit/issues"
  },
  "homepage": "https://github.com/imaqib101/vue-composable-toolkit#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^1.1.0",
    "vue": "^3.4.0"
  }
}
