{
  "name": "@aqib/vue-composable-toolkit",
  "version": "1.0.0",
  "description": "High-performance, tree-shakeable Vue 3 composables for enterprise applications",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts"
  },
  "keywords": ["vue3", "composables", "typescript", "reactivity", "frontend", "utilities"],
  "author": "Mohammed Aqib <imaqib101@users.noreply.github.com>",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue": "^3.3.4",
    "vue-tsc": "^1.8.0"
  }
}
